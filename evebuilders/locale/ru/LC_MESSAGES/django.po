msgstr "В контракте нет предмета %(item)s."

#: reasons.py
#, python-format
msgid "The price must be %(expected)s ISK for %(quantity)s items."
msgstr "Цена должна быть %(expected)s ISK за %(quantity)s шт."

#: reasons.py
#, python-format
msgid ""
"Only %(available)s items are left to deliver, the contract has %(quantity)s."
msgstr "Осталось сдать только %(available)s шт., а в контракте %(quantity)s."

#: reasons.py
msgid "The items are no longer available to deliver."
msgstr "Эти предметы больше недоступны для сдачи."

#: reasons.py
msgid "The order was cancelled."
msgstr "Заказ отменён."

